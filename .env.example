# Copy to .env.local and fill in, or run `npx vercel env pull .env.local`
# once the Vercel project is linked. Never commit .env.local.
# Setup steps for each service: see SETUP.md.

# --- App ---
# Random string, 16+ characters. Used to hash visitor IPs for rate limiting.
IP_HASH_SALT=

# --- Neon Postgres (added automatically by the Vercel Neon integration) ---
DATABASE_URL=
# Direct (non-pooled) connection, used by `npm run db:migrate`.
DATABASE_URL_UNPOOLED=

# --- Better Auth ---
# 32+ random characters. Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
BETTER_AUTH_SECRET=
# Public URL of the site. http://localhost:3000 locally.
BETTER_AUTH_URL=http://localhost:3000

# --- Google OAuth (candidates) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Resend (admin invites and password resets) ---
RESEND_API_KEY=
EMAIL_FROM=Lens <no-reply@talentmuscle.com>

# --- Groq (console.groq.com > API Keys) ---
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GROQ_FALLBACK_MODEL=llama-3.3-70b-versatile

# --- Microsoft Entra app + SharePoint ---
MS_TENANT_ID=
MS_CLIENT_ID=
MS_CLIENT_SECRET=
# Graph site id, format: contoso.sharepoint.com,<site-guid>,<web-guid>
SHAREPOINT_SITE_ID=
SHAREPOINT_ROOT_FOLDER=Resumes

# --- Cloudflare Turnstile ---
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
