# Copy to .env.local and fill in. Never commit .env.local.
# Setup steps for each service: see SETUP.md.

# --- App ---
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Random string, 16+ characters. Used to hash visitor IPs for rate limiting.
IP_HASH_SALT=

# --- Supabase (Project Settings > API Keys) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server only. Bypasses row level security.
SUPABASE_SECRET_KEY=

# --- Groq (console.groq.com > API Keys) ---
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GROQ_FALLBACK_MODEL=llama-3.3-70b-versatile

# --- Microsoft Entra app + SharePoint ---
MS_TENANT_ID=
MS_CLIENT_ID=
MS_CLIENT_SECRET=
# Graph site id, format: contoso.sharepoint.com,<site-guid>,<web-guid>
SHAREPOINT_SITE_ID=
SHAREPOINT_ROOT_FOLDER=Resumes

# --- Cloudflare Turnstile ---
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
